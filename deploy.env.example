# Copy to .env.deploy on the deployment server and keep it untracked (chmod 600).
DB_NAME=financeapp
DB_USER=financeapp
DB_PASSWORD=replace-with-a-long-random-password
JWT_SECRET=replace-with-a-long-random-secret
PEPPER=replace-with-a-long-random-secret
ENCRYPTION_KEY=replace-with-a-long-random-secret
EODHD_API_KEY=

# TrueLayer Data API. Register this exact callback URL in TrueLayer Console.
TRUELAYER_CLIENT_ID=
TRUELAYER_CLIENT_SECRET=
TRUELAYER_REDIRECT_URI=https://finance.saulmoreno.es/api/bank-sync/truelayer/callback
TRUELAYER_PROVIDER_ID=
WEB_APP_URL=https://finance.saulmoreno.es

# Add the URL used by the browser if it is not accessed through localhost.
CORS_ORIGINS=https://finance.saulmoreno.es,http://localhost:8080,http://127.0.0.1:8080
# Keep the fallback port bound to localhost; public traffic enters via Traefik.
WEB_PORT=127.0.0.1:8080
