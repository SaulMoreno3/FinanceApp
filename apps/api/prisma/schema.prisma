generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Currency {
  EUR
  USD
}

enum TradeSide {
  Buy
  Sell
}

enum InstrumentType {
  STOCK
  ETF
  FUND
  CRYPTO
  INDEX
  FOREX
  OTHER
}

enum ProjectEntryType {
  INCOME
  EXPENSE
}

enum ProjectStatus {
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum ProjectPaymentStatus {
  PENDING
  PAID
}

enum DebtStatus {
  ACTIVE
  PAID_OFF
  ARCHIVED
}

model User {
  id                   String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                String                   @unique @db.VarChar(255)
  passwordHash         String                   @map("password_hash") @db.VarChar(255)
  name                 String?                  @db.VarChar(100)
  avatarIcon           String                   @default("user-round") @db.VarChar(32)
  avatarColor          String                   @default("slate") @db.VarChar(24)
  locale               String                   @default("es-ES") @db.VarChar(10)
  timezone             String                   @default("Europe/Madrid") @db.VarChar(64)
  preferredCurrency    Currency                 @default(EUR)
  sessionVersion       Int                      @default(0)
  createdAt            DateTime                 @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime                 @default(now()) @updatedAt @db.Timestamptz(6)
  stockTrades          StockTrade[]
  cashTransfers        CashTransfer[]
  netWorthAssets       NetWorthAsset[]
  salaryRecords        SalaryRecord[]
  importHistory        ImportHistory[]
  salaryPdfPasswords   SalaryPdfPassword[]
  taxReturns           TaxReturn[]
  projects             Project[]
  portfolioSnapshots   PortfolioDailySnapshot[]
  realEstateProperties RealEstateProperty[]
  debts                Debt[]
  bankConnections      BankConnection[]
  bankAccounts         BankAccount[]
  bankTransactions     BankTransaction[]
  financePlan          FinancePlan?
  financeClosings      FinanceMonthClosing[]
  expenseCards         ExpenseCard[]
  expenseEntries       ExpenseEntry[]
  expenseTokens        ExpenseToken[]
  expenseRules         ExpenseRule[]
  expenseBudgets       ExpenseBudget[]
  expenseStatements    ExpenseStatement[]
  expenseSyncStatus    ExpenseSyncStatus?
  expenseWalletCards   ExpenseWalletCard[]
  expenseWalletCaptures ExpenseWalletCapture[]

  @@map("users")
}

model Project {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  description String?
  client      String?
  budget      Decimal?       @db.Decimal(14, 2)
  status      ProjectStatus  @default(ACTIVE)
  userId      String         @db.Uuid
  createdAt   DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime       @default(now()) @updatedAt @db.Timestamptz(6)
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries     ProjectEntry[]

  @@index([userId])
  @@map("projects")
}

model ProjectEntry {
  id             String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId      String               @db.Uuid
  type           ProjectEntryType
  amount         Decimal              @db.Decimal(14, 2)
  description    String
  category       String?
  counterparty   String?
  reference      String?
  notes          String?
  paymentStatus  ProjectPaymentStatus @default(PAID)
  date           DateTime             @db.Date
  dueDate        DateTime?            @db.Date
  fileName       String?
  fileStorageKey String?
  fileMimeType   String?
  createdAt      DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime             @default(now()) @updatedAt @db.Timestamptz(6)
  project        Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([projectId, date])
  @@index([projectId, paymentStatus])
  @@map("project_entries")
}

model Debt {
  id                String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String         @db.VarChar(160)
  lender            String?        @db.VarChar(160)
  assetName         String?        @db.VarChar(160)
  originalPrincipal Decimal        @db.Decimal(14, 2)
  totalRepayable    Decimal?       @db.Decimal(14, 2)
  currentBalance    Decimal        @db.Decimal(14, 2)
  interestRate      Decimal?       @db.Decimal(8, 4)
  apr               Decimal?       @db.Decimal(8, 4)
  monthlyPayment    Decimal?       @db.Decimal(14, 2)
  totalPayments     Int?
  paidPayments      Int            @default(0)
  startDate         DateTime?      @db.Date
  maturityDate      DateTime?      @db.Date
  nextPaymentDate   DateTime?      @db.Date
  currency          Currency       @default(EUR)
  status            DebtStatus     @default(ACTIVE)
  notes             String?
  userId            String         @db.Uuid
  createdAt         DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime       @default(now()) @updatedAt @db.Timestamptz(6)
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  schedule          DebtSchedule[]
  payments          DebtPayment[]

  @@index([userId])
  @@index([userId, status])
  @@map("debts")
}

model DebtSchedule {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  debtId          String   @db.Uuid
  installment     Int
  dueDate         DateTime @db.Date
  paymentAmount   Decimal  @db.Decimal(14, 2)
  principalAmount Decimal  @db.Decimal(14, 2)
  interestAmount  Decimal  @db.Decimal(14, 2)
  balanceAfter    Decimal  @db.Decimal(14, 2)
  debt            Debt     @relation(fields: [debtId], references: [id], onDelete: Cascade)

  @@unique([debtId, installment])
  @@index([debtId, dueDate])
  @@map("debt_schedule")
}

model DebtPayment {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  debtId            String          @db.Uuid
  bankTransactionId String          @unique @db.Uuid
  installment       Int
  paidAt            DateTime        @db.Timestamptz(6)
  amount            Decimal         @db.Decimal(14, 2)
  principalAmount   Decimal         @db.Decimal(14, 2)
  interestAmount    Decimal         @db.Decimal(14, 2)
  detectedAt        DateTime        @default(now()) @db.Timestamptz(6)
  debt              Debt            @relation(fields: [debtId], references: [id], onDelete: Cascade)
  bankTransaction   BankTransaction @relation(fields: [bankTransactionId], references: [id], onDelete: Cascade)

  @@unique([debtId, installment])
  @@index([debtId, paidAt])
  @@map("debt_payments")
}

model StockTrade {
  id                String         @id
  date              DateTime       @db.Timestamp(3)
  currency          Currency
  symbol            String
  isin              String?        @db.VarChar(20)
  name              String?        @db.VarChar(255)
  assetType         String?
  type              String         @default("Trade - Market")
  quantity          Decimal        @db.Decimal(20, 8)
  price             Decimal        @db.Decimal(20, 8)
  side              TradeSide
  value             Decimal        @db.Decimal(20, 8)
  eurCost           Float?
  eurValue          Decimal?       @db.Decimal(20, 8)
  conversionRate    Float?
  costBasisOverride Float?
  fees              Decimal        @db.Decimal(20, 8)
  commission        Decimal        @db.Decimal(20, 8)
  source            String?
  userId            String?        @db.Uuid
  instrumentId      String?        @db.Uuid
  listingId         String?        @db.Uuid
  createdAt         DateTime       @default(now()) @db.Timestamp(3)
  updatedAt         DateTime       @db.Timestamp(3)
  user              User?          @relation(fields: [userId], references: [id])
  instrument        Instrument?    @relation(fields: [instrumentId], references: [id])
  listing           MarketListing? @relation(fields: [listingId], references: [id])

  @@unique([userId, date, currency, symbol, side, quantity, price])
  @@index([userId])
  @@index([instrumentId])
  @@index([listingId])
  @@map("stock_trades")
}

model Instrument {
  id                String                           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  canonicalKey      String                           @unique @db.VarChar(255)
  isin              String?                          @unique @db.VarChar(20)
  figi              String?                          @unique @db.VarChar(32)
  name              String                           @db.VarChar(255)
  type              InstrumentType                   @default(OTHER)
  createdAt         DateTime                         @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime                         @default(now()) @updatedAt @db.Timestamptz(6)
  listings          MarketListing[]
  stockTrades       StockTrade[]
  positionSnapshots PortfolioPositionDailySnapshot[]

  @@index([name])
  @@map("instruments")
}

model MarketListing {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  instrumentId   String           @db.Uuid
  ticker         String           @db.VarChar(64)
  exchangeCode   String?          @db.VarChar(32)
  exchangeMic    String?          @db.VarChar(8)
  currency       Currency
  provider       String           @db.VarChar(32)
  providerSymbol String           @db.VarChar(128)
  isPrimary      Boolean          @default(false)
  createdAt      DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime         @default(now()) @updatedAt @db.Timestamptz(6)
  instrument     Instrument       @relation(fields: [instrumentId], references: [id], onDelete: Cascade)
  prices         MarketPriceBar[]
  stockTrades    StockTrade[]

  @@unique([provider, providerSymbol])
  @@index([instrumentId])
  @@index([ticker])
  @@map("market_listings")
}

model MarketPriceBar {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  listingId     String        @db.Uuid
  date          DateTime      @db.Date
  open          Decimal?      @db.Decimal(20, 8)
  high          Decimal?      @db.Decimal(20, 8)
  low           Decimal?      @db.Decimal(20, 8)
  close         Decimal       @db.Decimal(20, 8)
  adjustedClose Decimal?      @db.Decimal(20, 8)
  volume        Decimal?      @db.Decimal(30, 8)
  currency      Currency
  source        String        @db.VarChar(32)
  createdAt     DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime      @default(now()) @updatedAt @db.Timestamptz(6)
  listing       MarketListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([listingId, date, source])
  @@index([date])
  @@map("market_price_bars")
}

model MarketFxRate {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  date          DateTime @db.Date
  baseCurrency  Currency
  quoteCurrency Currency
  rate          Decimal  @db.Decimal(20, 10)
  source        String   @db.VarChar(32)
  createdAt     DateTime @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@unique([date, baseCurrency, quoteCurrency, source])
  @@index([date])
  @@map("market_fx_rates")
}

model PortfolioDailySnapshot {
  id                   String                           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId               String                           @db.Uuid
  date                 DateTime                         @db.Date
  currency             Currency                         @default(EUR)
  marketValue          Decimal                          @db.Decimal(20, 8)
  costBasis            Decimal                          @db.Decimal(20, 8)
  realizedGain         Decimal                          @db.Decimal(20, 8)
  unrealizedGain       Decimal                          @db.Decimal(20, 8)
  dividends            Decimal                          @default(0) @db.Decimal(20, 8)
  fees                 Decimal                          @default(0) @db.Decimal(20, 8)
  cashInflows          Decimal                          @default(0) @db.Decimal(20, 8)
  cashOutflows         Decimal                          @default(0) @db.Decimal(20, 8)
  netContributions     Decimal                          @default(0) @db.Decimal(20, 8)
  dailyPnl             Decimal                          @default(0) @db.Decimal(20, 8)
  dailyReturn          Decimal                          @default(0) @db.Decimal(20, 12)
  hasEstimates         Boolean                          @default(false)
  marketValueAvailable Boolean                          @default(true)
  createdAt            DateTime                         @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime                         @default(now()) @updatedAt @db.Timestamptz(6)
  user                 User                             @relation(fields: [userId], references: [id], onDelete: Cascade)
  positions            PortfolioPositionDailySnapshot[]

  @@unique([userId, date, currency])
  @@index([userId, date])
  @@map("portfolio_daily_snapshots")
}

model PortfolioPositionDailySnapshot {
  id                String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  snapshotId        String                 @db.Uuid
  instrumentId      String                 @db.Uuid
  quantity          Decimal                @db.Decimal(20, 8)
  price             Decimal                @db.Decimal(20, 8)
  priceCurrency     Currency
  fxRateToReporting Decimal                @db.Decimal(20, 10)
  marketValue       Decimal                @db.Decimal(20, 8)
  costBasis         Decimal                @db.Decimal(20, 8)
  unrealizedGain    Decimal                @db.Decimal(20, 8)
  priceDate         DateTime               @db.Date
  isEstimated       Boolean                @default(false)
  snapshot          PortfolioDailySnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  instrument        Instrument             @relation(fields: [instrumentId], references: [id], onDelete: Cascade)

  @@unique([snapshotId, instrumentId])
  @@index([instrumentId])
  @@map("portfolio_position_daily_snapshots")
}

model CashTransfer {
  id                String   @id
  date              DateTime @db.Timestamp(3)
  currency          Currency
  type              String
  value             Decimal  @db.Decimal(20, 8)
  fees              Decimal  @db.Decimal(20, 8)
  commission        Decimal  @db.Decimal(20, 8)
  eurCost           Decimal? @db.Decimal(20, 8)
  conversionRate    Decimal? @db.Decimal(20, 8)
  skippedConversion Boolean  @default(false)
  source            String?
  userId            String?  @db.Uuid
  createdAt         DateTime @default(now()) @db.Timestamp(3)
  updatedAt         DateTime @db.Timestamp(3)
  user              User?    @relation(fields: [userId], references: [id])

  @@unique([userId, date, currency, type, value])
  @@index([userId])
  @@map("cash_transfers")
}

enum BankConnectionStatus {
  PENDING
  CONNECTED
  ERROR
  REAUTH_REQUIRED
  DISCONNECTED
}

model BankConnection {
  id                    String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                String               @db.Uuid
  provider              String               @db.VarChar(40)
  status                BankConnectionStatus @default(PENDING)
  accessTokenEncrypted  String?
  accessTokenIv         String?
  refreshTokenEncrypted String?
  refreshTokenIv        String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  oauthStateHash        String?              @db.VarChar(128)
  lastSyncAt            DateTime?
  lastError             String?
  createdAt             DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime             @default(now()) @updatedAt @db.Timestamptz(6)
  user                  User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  accounts              BankAccount[]
  expenseCards          ExpenseCard[]

  @@unique([userId, provider])
  @@index([userId, status])
  @@map("bank_connections")
}

model BankAccount {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String            @db.Uuid
  connectionId      String            @db.Uuid
  providerAccountId String            @db.VarChar(255)
  name              String?
  iban              String?
  currency          String            @db.VarChar(3)
  accountType       String?           @db.VarChar(40)
  balance           Decimal?          @db.Decimal(20, 8)
  availableBalance  Decimal?          @db.Decimal(20, 8)
  balanceUpdatedAt  DateTime?
  createdAt         DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime          @default(now()) @updatedAt @db.Timestamptz(6)
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  connection        BankConnection    @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  transactions      BankTransaction[]
  expenseCards      ExpenseCard[]

  @@unique([connectionId, providerAccountId])
  @@index([userId])
  @@map("bank_accounts")
}

model BankTransaction {
  id                    String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                String            @db.Uuid
  accountId             String            @db.Uuid
  providerTransactionId String            @db.VarChar(255)
  date                  DateTime          @db.Timestamptz(6)
  amount                Decimal           @db.Decimal(20, 8)
  currency              String            @db.VarChar(3)
  description           String?
  merchantName          String?
  category              String?
  direction             String            @db.VarChar(16)
  status                String            @default("booked") @db.VarChar(24)
  rawData               Json?
  createdAt             DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime          @updatedAt @db.Timestamptz(6)
  user                  User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  account               BankAccount       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  debtPayments          DebtPayment[]
  expenseEntry          ExpenseEntry?
  expenseStatement      ExpenseStatement?

  @@unique([accountId, providerTransactionId])
  @@index([userId, date])
  @@index([userId, category])
  @@map("bank_transactions")
}

model ExpenseCard {
  id             String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String             @db.Uuid
  name           String             @db.VarChar(100)
  kind           String             @db.VarChar(10)
  currency       String             @db.VarChar(3)
  bankAccountId  String?            @db.Uuid
  providerCardId String?            @db.VarChar(255)
  connectionId   String?            @db.Uuid
  openingBalance Decimal?           @db.Decimal(14, 2)
  openingDate    DateTime           @db.Date
  dueDay         Int                @default(1)
  balance        Decimal?           @db.Decimal(14, 2)
  balanceAt      DateTime?          @db.Timestamptz
  createdAt      DateTime           @default(now()) @db.Timestamptz
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  bankAccount    BankAccount?       @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)
  connection     BankConnection?    @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  entries        ExpenseEntry[]
  tokens         ExpenseToken[]
  statements     ExpenseStatement[]
  walletCards    ExpenseWalletCard[]

  @@unique([userId, providerCardId])
  @@unique([id, userId])
  @@index([userId])
  @@map("expense_cards")
}

model ExpenseEntry {
  id                String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String           @db.Uuid
  cardId            String           @db.Uuid
  date              DateTime         @db.Timestamptz
  amount            Decimal          @db.Decimal(14, 2)
  merchant          String           @db.VarChar(250)
  category          String?          @db.VarChar(100)
  categoryOverride  String?          @db.VarChar(100)
  source            String           @db.VarChar(20)
  sourceId          String           @db.VarChar(255)
  entryType         String           @default("PURCHASE") @db.VarChar(10)
  matchedEntryId    String?          @db.Uuid
  bankTransactionId String?          @unique @db.Uuid
  excluded          Boolean          @default(false)
  provisional       Boolean          @default(false)
  createdAt         DateTime         @default(now()) @db.Timestamptz
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  card              ExpenseCard      @relation(fields: [cardId, userId], references: [id, userId], onDelete: Cascade)
  matchedEntry      ExpenseEntry?    @relation("ExpenseMatch", fields: [matchedEntryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  matchedCaptures   ExpenseEntry[]   @relation("ExpenseMatch")
  bankTransaction   BankTransaction? @relation(fields: [bankTransactionId], references: [id], onDelete: SetNull)
  walletCapture     ExpenseWalletCapture?

  @@unique([cardId, source, sourceId])
  @@index([userId, date])
  @@map("expense_entries")
}

model ExpenseToken {
  id         String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String      @db.Uuid
  cardId     String      @db.Uuid
  name       String      @db.VarChar(100)
  tokenHash  String      @unique @db.VarChar(64)
  scope      String      @default("CARD") @db.VarChar(10)
  createdAt  DateTime    @default(now()) @db.Timestamptz
  lastUsedAt DateTime?   @db.Timestamptz
  revokedAt  DateTime?   @db.Timestamptz
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  card       ExpenseCard @relation(fields: [cardId, userId], references: [id, userId], onDelete: Cascade)

  @@map("expense_tokens")
}

model ExpenseWalletCard {
  id         String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String @db.Uuid
  name       String @db.VarChar(250)
  walletKey  String @db.VarChar(250)
  currency   String @db.VarChar(3)
  cardId     String? @db.Uuid
  lastSeenAt DateTime @default(now()) @db.Timestamptz
  user       User @relation(fields: [userId], references: [id], onDelete: Cascade)
  card       ExpenseCard? @relation(fields: [cardId, userId], references: [id, userId], onDelete: NoAction, onUpdate: NoAction)
  captures   ExpenseWalletCapture[]

  @@unique([userId, walletKey, currency])
  @@unique([id, userId])
  @@map("expense_wallet_cards")
}

model ExpenseWalletCapture {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String @db.Uuid
  walletCardId   String @db.Uuid
  eventId        String @db.VarChar(255)
  date           DateTime @db.Timestamptz
  amount         Decimal @db.Decimal(14, 2)
  merchant       String @db.VarChar(250)
  entryType      String @db.VarChar(10)
  expenseEntryId String? @unique @db.Uuid
  categoryOverride String? @db.VarChar(100)
  excluded       Boolean @default(false)
  user           User @relation(fields: [userId], references: [id], onDelete: Cascade)
  walletCard     ExpenseWalletCard @relation(fields: [walletCardId, userId], references: [id, userId], onDelete: Cascade)
  expenseEntry   ExpenseEntry? @relation(fields: [expenseEntryId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([walletCardId, eventId])
  @@index([userId])
  @@map("expense_wallet_captures")
}

model ExpenseRule {
  userId   String @db.Uuid
  merchant String @db.VarChar(250)
  category String @db.VarChar(100)
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, merchant])
  @@map("expense_rules")
}

model ExpenseBudget {
  userId   String  @db.Uuid
  category String  @db.VarChar(100)
  amount   Decimal @db.Decimal(14, 2)
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, category])
  @@map("expense_budgets")
}

model ExpenseStatement {
  id                String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String           @db.Uuid
  cardId            String           @db.Uuid
  startDate         DateTime         @db.Date
  endDate           DateTime         @db.Date
  dueDate           DateTime         @db.Date
  amount            Decimal          @db.Decimal(14, 2)
  bankTransactionId String?          @unique @db.Uuid
  createdAt         DateTime         @default(now()) @db.Timestamptz
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  card              ExpenseCard      @relation(fields: [cardId, userId], references: [id, userId], onDelete: Cascade)
  bankTransaction   BankTransaction? @relation(fields: [bankTransactionId], references: [id], onDelete: SetNull)

  @@unique([cardId, startDate, endDate])
  @@map("expense_statements")
}

model ExpenseSyncStatus {
  userId    String   @id @db.Uuid
  status    String   @db.VarChar(30)
  message   String
  checkedAt DateTime @default(now()) @db.Timestamptz
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("expense_sync_status")
}

model NetWorthAsset {
  id               String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String
  description      String?
  category         String?
  isSold           Boolean                  @default(false)
  soldAt           DateTime?                @db.Timestamptz(6)
  originalCost     Decimal                  @db.Decimal
  originalCurrency String?
  notes            String?
  userId           String?                  @db.Uuid
  createdAt        DateTime                 @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime                 @default(now()) @updatedAt @db.Timestamptz(6)
  user             User?                    @relation(fields: [userId], references: [id])
  valuations       NetWorthAssetValuation[]

  @@index([userId])
  @@index([category])
  @@index([isSold])
  @@map("networth_assets")
}

model NetWorthAssetValuation {
  id        String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assetId   String        @db.Uuid
  valuedAt  DateTime      @default(now()) @db.Timestamptz(6)
  value     Decimal       @db.Decimal
  currency  String?
  source    String?
  createdAt DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt DateTime      @default(now()) @updatedAt @db.Timestamptz(6)
  asset     NetWorthAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId])
  @@index([valuedAt])
  @@map("networth_asset_valuations")
}

model SalaryRecord {
  id             String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  date           DateTime?             @db.Timestamptz(6)
  grossSalary    Decimal?              @db.Decimal
  netSalary      Decimal?              @db.Decimal
  company        String?
  fileName       String?
  fileStorageKey String?
  notes          String?
  userId         String?               @db.Uuid
  createdAt      DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime              @default(now()) @updatedAt @db.Timestamptz(6)
  user           User?                 @relation(fields: [userId], references: [id])
  breakdown      SalaryBreakdownItem[]

  @@index([userId])
  @@index([date])
  @@map("salary_records")
}

model SalaryBreakdownItem {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  salaryId  String       @db.Uuid
  concept   String
  amount    Decimal      @db.Decimal
  type      String
  createdAt DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt DateTime     @default(now()) @updatedAt @db.Timestamptz(6)
  salary    SalaryRecord @relation(fields: [salaryId], references: [id], onDelete: Cascade)

  @@index([salaryId])
  @@map("salary_breakdown_items")
}

model ImportHistory {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  source           String
  filename         String
  status           String
  recordsProcessed Int      @default(0)
  createdAt        DateTime @default(now()) @db.Timestamptz(6)
  userId           String?  @db.Uuid
  user             User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("import_history")
}

model SalaryPdfPassword {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String   @db.Uuid
  encryptedPassword String
  iv                String
  label             String?
  createdAt         DateTime @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("salary_pdf_passwords")
}

model TaxReturn {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  taxYear        Int
  country        String    @default("Spain") @db.VarChar(80)
  status         String    @default("Draft") @db.VarChar(32)
  totalIncome    Decimal   @default(0) @db.Decimal(14, 2)
  taxPaid        Decimal   @default(0) @db.Decimal(14, 2)
  finalTaxResult Decimal?  @map("final_tax_result") @db.Decimal(14, 2)
  filingDate     DateTime? @db.Date
  notes          String?
  fileName       String?
  fileStorageKey String?
  fileMimeType   String?
  userId         String    @db.Uuid
  createdAt      DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, taxYear])
  @@map("tax_returns")
}

// One validated aggregate per property: rent history, expenses and receipt overrides
// are saved atomically. Version protects against lost concurrent edits.
model RealEstateProperty {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @db.Uuid
  data      Json     @db.JsonB
  version   Int      @default(1)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("real_estate_properties")
}

model FinancePlan {
  userId    String   @id @db.Uuid
  data      Json     @db.JsonB
  version   Int      @default(1)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("finance_plans")
}

model FinanceMonthClosing {
  userId      String   @db.Uuid
  month       String   @db.VarChar(7)
  snapshot    Json     @db.JsonB
  fingerprint String
  reviewedAt  DateTime @default(now()) @db.Timestamptz(6)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, month])
  @@map("finance_month_closings")
}
