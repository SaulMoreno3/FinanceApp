# Prisma uses this URL for introspection and migrations.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# The API currently supports the legacy DB_* variables too.
PORT=3001
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=financeapp

# Generate independent random 32-byte values for every environment.
JWT_SECRET=replace-with-64-random-hex-characters
PEPPER=replace-with-64-random-hex-characters
ENCRYPTION_KEY=replace-with-64-random-hex-characters

# Optional: EODHD fallback for mutual funds identified by ISIN.
# Create a key at https://eodhd.com/register and keep it only in apps/api/.env.
EODHD_API_KEY=

# TrueLayer Data API (set these after creating a TrueLayer application).
# The redirect URI must be registered exactly in TrueLayer Console.
TRUELAYER_CLIENT_ID=
TRUELAYER_CLIENT_SECRET=
TRUELAYER_REDIRECT_URI=https://finance.saulmoreno.es/api/bank-sync/truelayer/callback
TRUELAYER_PROVIDER_ID=
TRUELAYER_AUTH_URL=https://auth.truelayer.com
TRUELAYER_API_URL=https://api.truelayer.com
WEB_APP_URL=https://finance.saulmoreno.es
